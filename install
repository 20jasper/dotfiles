set -e
cd "$(dirname "$0")"

if ! command -v fzf &>/dev/null; then
  if command -v mise &>/dev/null; then
    mise use -g fzf -y
  else
    sudo dnf install -y fzf
  fi
fi

if [ -n "$1" ]; then
  mods=$(cat "profiles/$1")
else
  mods=$(ls modules | sed 's/\.sh$//' | fzf --multi)
fi

for m in $mods; do
  bash "modules/$m.sh"
done
